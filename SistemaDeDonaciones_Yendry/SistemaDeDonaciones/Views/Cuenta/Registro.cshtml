@{
    ViewData["Title"] = "Crear cuenta";
    Layout = "_Layout";
}

<section class="section-tight">
        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-6">
                <div class="text-center mb-4">
                    <span class="eyebrow d-inline-flex">Únete a Manos</span>
                    <h1 class="mt-2" style="font-size:1.9rem;">Crear cuenta de donante</h1>
                </div>

                <div class="form-card">
                    <form method="post" asp-controller="Cuenta" asp-action="Registro">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Nombre</label>
                                <input type="text" class="form-control" name="Nombre" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Apellidos</label>
                                <input type="text" class="form-control" name="Apellidos" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Correo electrónico</label>
                                <input type="email" class="form-control" name="Email" placeholder="nombre@correo.com" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Contraseña</label>
                                <input type="password" class="form-control" name="Contrasena" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Confirmar contraseña</label>
                                <input type="password" class="form-control" name="ConfirmarContrasena" />
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 btn-lg mt-3" disabled>Crear cuenta</button>
                        <p class="text-faint text-center mt-2" style="font-size:0.8rem;">
                                                             🎔
                        </p>
                    </form>
                </div>

                <p class="text-center text-soft mt-4" style="font-size:0.9rem;">
                    ¿Ya tienes cuenta?
                    <a asp-controller="Cuenta" asp-action="Login">Inicia sesión</a>
                </p>
        </div>
    </div>
</section>
