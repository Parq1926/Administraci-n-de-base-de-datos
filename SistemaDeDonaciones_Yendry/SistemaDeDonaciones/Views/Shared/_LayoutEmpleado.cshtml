@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    string NavClass(string action) => currentAction == action ? "active" : "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Panel de Empleado</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="app-shell">
        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <aside class="sidebar" id="appSidebar">
            <a class="sidebar-brand" asp-controller="Empleado" asp-action="Index">
                <span class="mark"><i class="bi bi-heart-fill"></i></span>
                Donaciones
            </a>
            <p class="sidebar-tagline">Panel de empleado</p>

            <div class="sidebar-section-label">General</div>
            <nav class="sidebar-nav">
                <a class="@NavClass("Index")" asp-controller="Empleado" asp-action="Index">
                    <i class="bi bi-grid-1x2-fill"></i> Inicio
                </a>
            </nav>

            <div class="sidebar-section-label mt-3">Mantenimiento</div>
            <nav class="sidebar-nav">
                <a class="@NavClass("Donantes")" asp-controller="Empleado" asp-action="Donantes">
                    <i class="bi bi-person-fill"></i> Donantes
                </a>
                <a class="@NavClass("Fundaciones")" asp-controller="Empleado" asp-action="Fundaciones">
                    <i class="bi bi-bank"></i> Fundaciones
                </a>
                <a class="@NavClass("Proyectos")" asp-controller="Empleado" asp-action="Proyectos">
                    <i class="bi bi-folder2-open"></i> Proyectos
                </a>
                <a class="@NavClass("CodigosDonacion")" asp-controller="Empleado" asp-action="CodigosDonacion">
                    <i class="bi bi-upc-scan"></i> Códigos de donación
                </a>
                <a class="@NavClass("Donaciones")" asp-controller="Empleado" asp-action="Donaciones">
                    <i class="bi bi-cash-coin"></i> Donaciones
                </a>
                <a class="@NavClass("Usuarios")" asp-controller="Empleado" asp-action="Usuarios">
                    <i class="bi bi-people-fill"></i> Usuarios
                </a>
            </nav>

            <div class="sidebar-section-label mt-3">Actividad</div>
            <nav class="sidebar-nav">
                <a class="@NavClass("Movimientos")" asp-controller="Empleado" asp-action="Movimientos">
                    <i class="bi bi-arrow-left-right"></i> Movimientos
                </a>
                <a class="@NavClass("Alertas")" asp-controller="Empleado" asp-action="Alertas">
                    <i class="bi bi-bell-fill"></i> Alertas
                </a>
                <a class="@NavClass("HistorialCodigos")" asp-controller="Empleado" asp-action="HistorialCodigos">
                    <i class="bi bi-clock-history"></i> Historial de códigos
                </a>
            </nav>

            <div class="sidebar-footer">
                <a class="sidebar-nav-link logout" asp-controller="Home" asp-action="Index" style="color:#ffd7d2; font-size:0.85rem; font-weight:600;">
                    <i class="bi bi-box-arrow-left"></i> Cerrar sesión
                </a>
            </div>
        </aside>

        <div class="main">
            <div class="mobile-topbar">
                <button id="sidebarToggle" class="btn btn-ghost btn-sm" type="button" aria-label="Abrir menú" aria-controls="appSidebar" aria-expanded="false">
                    <i class="bi bi-list"></i>
                </button>
                <span class="sidebar-brand" style="margin:0; color:var(--ink);">
                    <span class="mark" style="background:var(--primary); border-color:var(--primary);"><i class="bi bi-heart-fill"></i></span> Donaciones
                </span>
            </div>

            <main class="main-inner">
                <div class="app-topbar">
                    <div>
                        <h1>@ViewData["Title"]</h1>
                        <p>@ViewData["Subtitle"]</p>
                    </div>
                    <div class="app-topbar__actions">
                 
                        <div class="user-chip">
                            <span class="avatar">P</span>
                            <div>
                                <div class="user-name">Prueba</div>
                                <div class="user-role">Administradora</div>
                            </div>
                        </div>
                    </div>
                </div>

                @RenderBody()

                <div class="page-footer">
                    &copy; 2026 DonacionesDB — Panel interno de empleados.
                </div>
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
