@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    string NavClass(string action) => currentAction == action ? "active" : "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Manos Unidas</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="app-shell">
        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <aside class="sidebar" id="appSidebar">
            <a class="sidebar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="mark"><i class="bi bi-heart-fill"></i></span>
                Manos Unidas
            </a>
            <p class="sidebar-tagline">Juntos hacemos la diferencia</p>

            <div class="sidebar-section-label">Navegación</div>
            <nav class="sidebar-nav">
                <a class="@NavClass("Index")" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house-door-fill"></i> Inicio
                </a>
            </nav>

            <div class="sidebar-footer">
                <a class="btn btn-sidebar-login btn-sm" asp-area="" asp-controller="Cuenta" asp-action="Login">Iniciar sesión</a>
                <span class="sidebar-register-hint">
                    ¿No tienes cuenta? <a asp-area="" asp-controller="Cuenta" asp-action="Registro">Regístrate</a>
                </span>
            </div>
        </aside>

        <div class="main">
            <div class="mobile-topbar">
                <button id="sidebarToggle" class="btn btn-ghost btn-sm" type="button" aria-label="Abrir menú" aria-controls="appSidebar" aria-expanded="false">
                    <i class="bi bi-list"></i>
                </button>
                <span class="sidebar-brand" style="margin:0; color:var(--ink);">
                    <span class="mark" style="background:var(--primary); border-color:var(--primary);"><i class="bi bi-heart-fill"></i></span> Donaciones
                </span>
            </div>

            <main class="main-inner">
                @RenderBody()
                <div class="page-footer">
                    &copy; 2026 Plataforma de Donaciones. ·
                    <a href="#">Uso</a> · <a href="#">Privacidad</a> · <a href="#">2026</a>
                </div>
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
