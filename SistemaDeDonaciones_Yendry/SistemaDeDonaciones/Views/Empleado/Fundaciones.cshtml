@model List<Fundacion>
@{
    var buscar = ViewData["Buscar"] as string;
    var activoFiltro = ViewData["ActivoFiltro"] as bool?;
}

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Exito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="panel">
    <div class="panel-header">
        <h2>Listado de fundaciones</h2>
        <button class="btn btn-primary btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#modalFundacionNueva">
            <i class="bi bi-plus-lg"></i> Agregar fundación
        </button>
    </div>

    <form method="get" asp-action="Fundaciones" class="filter-bar row g-2">
        <div class="col-md-6">
            <input type="text" name="buscar" value="@buscar" class="form-control" placeholder="Buscar por nombre o correo..." />
        </div>
        <div class="col-md-3">
            <select name="activo" class="form-select">
                <option value="">Todos los estados</option>
                <option value="true" selected="@(activoFiltro == true)">Activa</option>
                <option value="false" selected="@(activoFiltro == false)">Inactiva</option>
            </select>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-outline-secondary w-100"><i class="bi bi-filter"></i> Filtrar</button>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-ledger mb-0">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Identificación</th>
                    <th>Email</th>
                    <th>Teléfono</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-soft py-4">No hay fundaciones registradas con estos filtros.</td></tr>
                }
                @foreach (var f in Model)
                {
                    <tr>
                        <td>@f.Nombre</td>
                        <td class="mono text-soft">@f.Identificacion</td>
                        <td class="text-soft">@f.Email</td>
                        <td class="text-soft">@f.Telefono</td>
                        <td>
                            @if (f.Activo == true)
                            {
                                <span class="badge-estado badge-activo">Activa</span>
                            }
                            else
                            {
                                <span class="badge-estado badge-inactivo">Inactiva</span>
                            }
                        </td>
                        <td>
                            <div class="row-actions">
                                <button class="icon-btn" type="button" title="Editar"
                                        data-bs-toggle="modal" data-bs-target="#modalFundacionEditar"
                                        data-id="@f.IdFundacion" data-nombre="@f.Nombre" data-descripcion="@f.Descripcion"
                                        data-identificacion="@f.Identificacion" data-email="@f.Email"
                                        data-telefono="@f.Telefono" data-direccion="@f.Direccion"
                                        data-activo="@((f.Activo ?? true).ToString().ToLower())">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <form method="post" asp-action="EliminarFundacion" style="display:inline"
                                      onsubmit="return confirm('¿Eliminar la fundación @f.Nombre?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="idFundacion" value="@f.IdFundacion" />
                                    <button class="icon-btn danger" type="submit" title="Eliminar"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!--Modal Agregar Fundación-->
<div class="modal fade" id="modalFundacionNueva" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form method="post" asp-action="CrearFundacion" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title">Nueva fundación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">Nombre</label>
                        <input type="text" name="Nombre" class="form-control" required />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Descripción</label>
                        <textarea name="Descripcion" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Identificación jurídica</label>
                        <input type="text" name="Identificacion" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Teléfono</label>
                        <input type="text" name="Telefono" class="form-control" />
                    </div>
                    <div class="col-md-8">
                        <label class="form-label">Email</label>
                        <input type="email" name="Email" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Estado</label>
                        <select name="Activo" class="form-select">
                            <option value="true">Activa</option>
                            <option value="false">Inactiva</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Dirección</label>
                        <input type="text" name="Direccion" class="form-control" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar fundación</button>
            </div>
        </form>
    </div>
</div>

<!--Modal Editar Fundación-->
<div class="modal fade" id="modalFundacionEditar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form method="post" asp-action="EditarFundacion" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="IdFundacion" id="editIdFundacion" />
            <div class="modal-header">
                <h5 class="modal-title">Editar fundación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">Nombre</label>
                        <input type="text" name="Nombre" id="editNombre" class="form-control" required />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Descripción</label>
                        <textarea name="Descripcion" id="editDescripcion" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Identificación jurídica</label>
                        <input type="text" name="Identificacion" id="editIdentificacion" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Teléfono</label>
                        <input type="text" name="Telefono" id="editTelefono" class="form-control" />
                    </div>
                    <div class="col-md-8">
                        <label class="form-label">Email</label>
                        <input type="email" name="Email" id="editEmail" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Estado</label>
                        <select name="Activo" id="editActivo" class="form-select">
                            <option value="true">Activa</option>
                            <option value="false">Inactiva</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Dirección</label>
                        <input type="text" name="Direccion" id="editDireccion" class="form-control" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar cambios</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        //Rellena el modal
        document.getElementById('modalFundacionEditar').addEventListener('show.bs.modal', function (event) {
            const btn = event.relatedTarget;
            document.getElementById('editIdFundacion').value = btn.getAttribute('data-id');
            document.getElementById('editNombre').value = btn.getAttribute('data-nombre') || '';
            document.getElementById('editDescripcion').value = btn.getAttribute('data-descripcion') || '';
            document.getElementById('editIdentificacion').value = btn.getAttribute('data-identificacion') || '';
            document.getElementById('editEmail').value = btn.getAttribute('data-email') || '';
            document.getElementById('editTelefono').value = btn.getAttribute('data-telefono') || '';
            document.getElementById('editDireccion').value = btn.getAttribute('data-direccion') || '';
            document.getElementById('editActivo').value = btn.getAttribute('data-activo') === 'true' ? 'true' : 'false';
        });
    </script>
}
