@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_Layout";
}

<section class="section-tight">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="text-center mb-4">
                    <span class="eyebrow d-inline-flex">Bienvenido de nuevo</span>
                    <h1 class="mt-2" style="font-size:1.9rem;">Iniciar sesión</h1>
                </div>

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <div class="form-card">
                    <form method="post" asp-controller="Cuenta" asp-action="Login">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label">Correo electrónico</label>
                            <input type="email" class="form-control" name="Email" placeholder="nombre@correo.com" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Contraseña</label>
                            <input type="password" class="form-control" name="Contrasena" placeholder="••••••••" required />
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-3">

                        </div>
                        <button type="submit" class="btn btn-primary w-100 btn-lg">Iniciar sesión</button>
                    </form>
                </div>

                <p class="text-center text-soft mt-4" style="font-size:0.9rem;">
                    ¿No tienes cuenta?
                    <a asp-controller="Cuenta" asp-action="Registro">Regístrate aquí</a>
                </p>

                <div class="card-surface p-3 mt-4" style="background: var(--bg);">
                    <p class="text-faint mb-2" style="font-size:0.78rem; text-transform:uppercase; letter-spacing:.05em;">
                        Pruebas sin login
                    </p>
                    <div class="d-flex gap-2">
                        <a class="btn btn-ghost btn-sm w-100" asp-controller="Empleado" asp-action="Index">
                            <i class="bi bi-speedometer2"></i> Panel Empleado
                        </a>
                        <a class="btn btn-ghost btn-sm w-100" asp-controller="Cliente" asp-action="Index">
                            <i class="bi bi-person-badge"></i> Panel Cliente
                        </a>
                    </div>
                </div>
        </div>
    </div>
</section>
