@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    string NavClass(string action) => currentAction == action ? "active" : "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mi cuenta</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="app-shell">
        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <aside class="sidebar" id="appSidebar">
            <a class="sidebar-brand" asp-controller="Cliente" asp-action="Index">
                <span class="mark"><i class="bi bi-heart-fill"></i></span>
                Donaciones
            </a>
            <p class="sidebar-tagline">Mi cuenta de donante</p>

            <div class="sidebar-section-label">Navegación</div>
            <nav class="sidebar-nav">
                <a class="@NavClass("Index")" asp-controller="Cliente" asp-action="Index">
                    <i class="bi bi-grid-1x2-fill"></i> Inicio
                </a>
                <a class="@NavClass("Donar")" asp-controller="Cliente" asp-action="Donar">
                    <i class="bi bi-heart"></i> Donar
                </a>
                <a class="@NavClass("MisDonaciones")" asp-controller="Cliente" asp-action="MisDonaciones">
                    <i class="bi bi-receipt"></i> Mis donaciones
                </a>
                <a class="@NavClass("MiPerfil")" asp-controller="Cliente" asp-action="MiPerfil">
                    <i class="bi bi-person-fill"></i> Mi perfil
                </a>
            </nav>

            <div class="sidebar-footer">
                <form method="post" asp-controller="Cuenta" asp-action="Logout">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="sidebar-nav-link logout" style="color:#ffd7d2; font-size:0.85rem; font-weight:600; background:none; border:none; width:100%; text-align:left;">
                        <i class="bi bi-box-arrow-left"></i> Cerrar sesión
                    </button>
                </form>
            </div>
        </aside>

        <div class="main">
            <div class="mobile-topbar">
                <button id="sidebarToggle" class="btn btn-ghost btn-sm" type="button" aria-label="Abrir menú" aria-controls="appSidebar" aria-expanded="false">
                    <i class="bi bi-list"></i>
                </button>
                <span class="sidebar-brand" style="margin:0; color:var(--ink);">
                    <span class="mark" style="background:var(--primary); border-color:var(--primary);"><i class="bi bi-heart-fill"></i></span> Donaciones
                </span>
            </div>

            <main class="main-inner">
                <div class="app-topbar">
                    <div>
                        <h1>@ViewData["Title"]</h1>
                        <p>@ViewData["Subtitle"]</p>
                    </div>
                    <div class="app-topbar__actions">
                        
                        <div class="user-chip">
                            <span class="avatar">PC</span>
                            <div>
                                <div class="user-name">Prueba Cliente</div>
                                <div class="user-role">Donante</div>
                            </div>
                        </div>
                    </div>
                </div>

                @RenderBody()

                <div class="page-footer">
                    &copy; 2026 DonacionesDB — Gracias por tu apoyo.
                </div>
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
