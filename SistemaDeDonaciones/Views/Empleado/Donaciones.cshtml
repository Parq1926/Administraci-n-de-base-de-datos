@model List<Donacion>
@{
    var donantes = ViewData["Donantes"] as List<Donante> ?? new();
    var proyectos = ViewData["Proyectos"] as List<Proyecto> ?? new();
    var estadoFiltro = ViewData["EstadoFiltro"] as string;
    var idProyectoFiltro = ViewData["IdProyectoFiltro"] as int?;
    var desde = ViewData["Desde"] as string;
    var hasta = ViewData["Hasta"] as string;
}

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Exito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="panel">
    <div class="panel-header">
        <h2>Listado de donaciones</h2>
        <button class="btn btn-primary btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#modalDonacionNueva">
            <i class="bi bi-plus-lg"></i> Registrar donación
        </button>
    </div>

    <form method="get" asp-action="Donaciones" class="filter-bar row g-2">
        <div class="col-md-3">
            <select name="estado" class="form-select">
                <option value="">Todos los estados</option>
                <option value="Pendiente" selected="@(estadoFiltro == "Pendiente")">Pendiente</option>
                <option value="Completada" selected="@(estadoFiltro == "Completada")">Completada</option>
                <option value="Cancelada" selected="@(estadoFiltro == "Cancelada")">Cancelada</option>
            </select>
        </div>
        <div class="col-md-3">
            <select name="idProyecto" class="form-select">
                <option value="">Todos los proyectos</option>
                @foreach (var p in proyectos)
                {
                    <option value="@p.IdProyecto" selected="@(idProyectoFiltro == p.IdProyecto)">@p.Nombre</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <input type="date" name="desde" value="@desde" class="form-control" />
        </div>
        <div class="col-md-2">
            <input type="date" name="hasta" value="@hasta" class="form-control" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-outline-secondary w-100"><i class="bi bi-filter"></i> Filtrar</button>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-ledger mb-0">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Donante</th>
                    <th>Proyecto</th>
                    <th>Método</th>
                    <th class="text-end">Monto</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-soft py-4">No hay donaciones registradas con estos filtros.</td></tr>
                }
                @foreach (var d in Model)
                {
                    <tr>
                        <td class="text-soft mono">@(d.FechaDonacion?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td>@d.DonanteNombreCompleto</td>
                        <td class="text-soft">@(d.ProyectoNombre ?? "—")</td>
                        <td class="text-soft">@d.MetodoPago</td>
                        <td class="text-end mono">₡@d.Monto.ToString("N0")</td>
                        <td>
                            @{
                                var badgeClass = d.Estado switch
                                {
                                    "Completada" => "badge-completada",
                                    "Cancelada" => "badge-cancelada",
                                    _ => "badge-pendiente"
                                };
                            }
                            <span class="badge-estado @badgeClass">@d.Estado</span>
                        </td>
                        <td>
                            <div class="row-actions">
                                <button class="icon-btn" type="button" title="Editar"
                                        data-bs-toggle="modal" data-bs-target="#modalDonacionEditar"
                                        data-id="@d.IdDonacion" data-monto="@d.Monto" data-metodopago="@d.MetodoPago"
                                        data-estado="@d.Estado" data-comentario="@d.Comentario"
                                        data-iddonante="@d.IdDonante" data-idproyecto="@d.IdProyecto">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <form method="post" asp-action="EliminarDonacion" style="display:inline"
                                      onsubmit="return confirm('¿Eliminar esta donación?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="idDonacion" value="@d.IdDonacion" />
                                    <button class="icon-btn danger" type="submit" title="Eliminar"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Registrar Donación -->
<div class="modal fade" id="modalDonacionNueva" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form method="post" asp-action="CrearDonacion" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title">Registrar donación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Donante</label>
                        <select name="IdDonante" class="form-select">
                            <option value="">— Sin asignar —</option>
                            @foreach (var don in donantes)
                            {
                                <option value="@don.IdDonante">@don.NombreCompleto</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Proyecto</label>
                        <select name="IdProyecto" class="form-select">
                            <option value="">— Sin asignar —</option>
                            @foreach (var p in proyectos)
                            {
                                <option value="@p.IdProyecto">@p.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Monto (₡)</label>
                        <input type="number" name="Monto" class="form-control" step="0.01" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Fecha de donación</label>
                        <input type="date" name="FechaDonacion" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Método de pago</label>
                        <select name="MetodoPago" class="form-select">
                            <option>Transferencia</option>
                            <option>Sinpe Móvil</option>
                            <option>Tarjeta de Crédito</option>
                            <option>Efectivo</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Estado</label>
                        <select name="Estado" class="form-select">
                            <option>Pendiente</option>
                            <option>Completada</option>
                            <option>Cancelada</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Comentario</label>
                        <textarea name="Comentario" class="form-control" rows="2"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar donación</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: Editar Donación -->
<div class="modal fade" id="modalDonacionEditar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form method="post" asp-action="EditarDonacion" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="IdDonacion" id="editIdDonacion" />
            <div class="modal-header">
                <h5 class="modal-title">Editar donación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Donante</label>
                        <select name="IdDonante" id="editIdDonante" class="form-select">
                            <option value="">— Sin asignar —</option>
                            @foreach (var don in donantes)
                            {
                                <option value="@don.IdDonante">@don.NombreCompleto</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Proyecto</label>
                        <select name="IdProyecto" id="editIdProyecto" class="form-select">
                            <option value="">— Sin asignar —</option>
                            @foreach (var p in proyectos)
                            {
                                <option value="@p.IdProyecto">@p.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Monto (₡)</label>
                        <input type="number" name="Monto" id="editMonto" class="form-control" step="0.01" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Método de pago</label>
                        <select name="MetodoPago" id="editMetodoPago" class="form-select">
                            <option>Transferencia</option>
                            <option>Sinpe Móvil</option>
                            <option>Tarjeta de Crédito</option>
                            <option>Efectivo</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Estado</label>
                        <select name="Estado" id="editEstadoDonacion" class="form-select">
                            <option>Pendiente</option>
                            <option>Completada</option>
                            <option>Cancelada</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Comentario</label>
                        <textarea name="Comentario" id="editComentario" class="form-control" rows="2"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar cambios</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('modalDonacionEditar').addEventListener('show.bs.modal', function (event) {
            const btn = event.relatedTarget;
            document.getElementById('editIdDonacion').value = btn.getAttribute('data-id');
            document.getElementById('editIdDonante').value = btn.getAttribute('data-iddonante') || '';
            document.getElementById('editIdProyecto').value = btn.getAttribute('data-idproyecto') || '';
            document.getElementById('editMonto').value = btn.getAttribute('data-monto') || '';
            document.getElementById('editMetodoPago').value = btn.getAttribute('data-metodopago') || 'Transferencia';
            document.getElementById('editEstadoDonacion').value = btn.getAttribute('data-estado') || 'Pendiente';
            document.getElementById('editComentario').value = btn.getAttribute('data-comentario') || '';
        });
    </script>
}
