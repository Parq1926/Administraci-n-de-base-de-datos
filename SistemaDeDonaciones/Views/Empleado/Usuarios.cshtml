@model List<Usuario>
@{
    var buscar = ViewData["Buscar"] as string;
    var tipoFiltro = ViewData["TipoUsuarioFiltro"] as string;
    var activoFiltro = ViewData["ActivoFiltro"] as bool?;
}

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Exito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="panel">
    <div class="panel-header">
        <h2>Listado de usuarios</h2>
        <button class="btn btn-primary btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#modalUsuarioNuevo">
            <i class="bi bi-plus-lg"></i> Agregar usuario
        </button>
    </div>

    <form method="get" asp-action="Usuarios" class="filter-bar row g-2">
        <div class="col-md-5">
            <input type="text" name="buscar" value="@buscar" class="form-control" placeholder="Buscar por nombre o email..." />
        </div>
        <div class="col-md-3">
            <select name="tipoUsuario" class="form-select">
                <option value="">Todos los tipos</option>
                <option value="Admin" selected="@(tipoFiltro == "Admin")">Admin</option>
                <option value="Usuario" selected="@(tipoFiltro == "Usuario")">Usuario</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="activo" class="form-select">
                <option value="">Todos los estados</option>
                <option value="true" selected="@(activoFiltro == true)">Activo</option>
                <option value="false" selected="@(activoFiltro == false)">Inactivo</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-outline-secondary w-100"><i class="bi bi-filter"></i> Filtrar</button>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-ledger mb-0">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Email</th>
                    <th>Tipo</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-soft py-4">No hay usuarios registrados con estos filtros.</td></tr>
                }
                @foreach (var u in Model)
                {
                    <tr>
                        <td>@u.Nombre @u.Apellidos</td>
                        <td class="text-soft">@u.Email</td>
                        <td>@u.TipoUsuario</td>
                        <td>
                            @if (u.Activo == true)
                            {
                                <span class="badge-estado badge-activo">Activo</span>
                            }
                            else
                            {
                                <span class="badge-estado badge-inactivo">Inactivo</span>
                            }
                        </td>
                        <td>
                            <div class="row-actions">
                                <button class="icon-btn" type="button" title="Editar"
                                        data-bs-toggle="modal" data-bs-target="#modalUsuarioEditar"
                                        data-id="@u.IdUsuario" data-nombre="@u.Nombre" data-apellidos="@u.Apellidos"
                                        data-email="@u.Email"
                                        data-tipo="@u.TipoUsuario" data-activo="@((u.Activo ?? true).ToString().ToLower())">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <form method="post" asp-action="EliminarUsuario" style="display:inline"
                                      onsubmit="return confirm('¿Eliminar al usuario @u.Nombre @u.Apellidos?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="idUsuario" value="@u.IdUsuario" />
                                    <button class="icon-btn danger" type="submit" title="Eliminar"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Agregar Usuario -->
<div class="modal fade" id="modalUsuarioNuevo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form method="post" asp-action="CrearUsuario" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title">Nuevo usuario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Nombre</label>
                        <input type="text" name="Nombre" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Apellidos</label>
                        <input type="text" name="Apellidos" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Email</label>
                        <input type="email" name="Email" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Contraseña temporal</label>
                        <input type="password" name="Contrasena" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Tipo de usuario</label>
                        <select name="TipoUsuario" class="form-select">
                            <option value="Usuario">Usuario</option>
                            <option value="Admin">Admin</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Estado</label>
                        <select name="Activo" class="form-select">
                            <option value="true">Activo</option>
                            <option value="false">Inactivo</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar usuario</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: Editar Usuario -->
<div class="modal fade" id="modalUsuarioEditar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form method="post" asp-action="EditarUsuario" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="IdUsuario" id="editIdUsuario" />
            <div class="modal-header">
                <h5 class="modal-title">Editar usuario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Nombre</label>
                        <input type="text" name="Nombre" id="editNombreUsuario" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Apellidos</label>
                        <input type="text" name="Apellidos" id="editApellidosUsuario" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Email</label>
                        <input type="email" name="Email" id="editEmailUsuario" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Nueva contraseña (opcional)</label>
                        <input type="password" name="Contrasena" id="editContrasenaUsuario" class="form-control" placeholder="Dejar en blanco para no cambiarla" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Tipo de usuario</label>
                        <select name="TipoUsuario" id="editTipoUsuario" class="form-select">
                            <option value="Usuario">Usuario</option>
                            <option value="Admin">Admin</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Estado</label>
                        <select name="Activo" id="editActivoUsuario" class="form-select">
                            <option value="true">Activo</option>
                            <option value="false">Inactivo</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar cambios</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('modalUsuarioEditar').addEventListener('show.bs.modal', function (event) {
            const btn = event.relatedTarget;
            document.getElementById('editIdUsuario').value = btn.getAttribute('data-id');
            document.getElementById('editNombreUsuario').value = btn.getAttribute('data-nombre') || '';
            document.getElementById('editApellidosUsuario').value = btn.getAttribute('data-apellidos') || '';
            document.getElementById('editEmailUsuario').value = btn.getAttribute('data-email') || '';
            document.getElementById('editContrasenaUsuario').value = '';
            document.getElementById('editTipoUsuario').value = btn.getAttribute('data-tipo') || 'Usuario';
            document.getElementById('editActivoUsuario').value = btn.getAttribute('data-activo') === 'true' ? 'true' : 'false';
        });
    </script>
}
