@model List<Donante>
@{
    var buscar = ViewData["Buscar"] as string;
    var tipoFiltro = ViewData["TipoDonanteFiltro"] as string;
    var activoFiltro = ViewData["ActivoFiltro"] as bool?;
}

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Exito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="panel">
    <div class="panel-header">
        <h2>Listado de donantes</h2>
        <button class="btn btn-primary btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#modalDonanteNuevo">
            <i class="bi bi-plus-lg"></i> Agregar donante
        </button>
    </div>

    <form method="get" asp-action="Donantes" class="filter-bar row g-2">
        <div class="col-md-5">
            <input type="text" name="buscar" value="@buscar" class="form-control" placeholder="Buscar por nombre o email..." />
        </div>
        <div class="col-md-3">
            <select name="tipoDonante" class="form-select">
                <option value="">Todos los tipos</option>
                <option value="Persona" selected="@(tipoFiltro == "Persona")">Persona</option>
                <option value="Empresa" selected="@(tipoFiltro == "Empresa")">Empresa</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="activo" class="form-select">
                <option value="">Todos los estados</option>
                <option value="true" selected="@(activoFiltro == true)">Activo</option>
                <option value="false" selected="@(activoFiltro == false)">Inactivo</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-outline-secondary w-100"><i class="bi bi-filter"></i> Filtrar</button>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-ledger mb-0">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Email</th>
                    <th>Teléfono</th>
                    <th>Tipo</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-soft py-4">No hay donantes registrados con estos filtros.</td></tr>
                }
                @foreach (var d in Model)
                {
                    <tr>
                        <td>@d.Nombre @d.Apellidos</td>
                        <td class="text-soft">@d.Email</td>
                        <td class="mono text-soft">@d.Telefono</td>
                        <td>@d.TipoDonante</td>
                        <td>
                            @if (d.Activo == true)
                            {
                                <span class="badge-estado badge-activo">Activo</span>
                            }
                            else
                            {
                                <span class="badge-estado badge-inactivo">Inactivo</span>
                            }
                        </td>
                        <td>
                            <div class="row-actions">
                                <button class="icon-btn" type="button" title="Editar"
                                        data-bs-toggle="modal" data-bs-target="#modalDonanteEditar"
                                        data-id="@d.IdDonante" data-nombre="@d.Nombre" data-apellidos="@d.Apellidos"
                                        data-email="@d.Email" data-telefono="@d.Telefono" data-direccion="@d.Direccion"
                                        data-tipo="@d.TipoDonante" data-activo="@((d.Activo ?? true).ToString().ToLower())">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <form method="post" asp-action="EliminarDonante" style="display:inline"
                                      onsubmit="return confirm('¿Eliminar al donante @d.Nombre @d.Apellidos?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="idDonante" value="@d.IdDonante" />
                                    <button class="icon-btn danger" type="submit" title="Eliminar"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Agregar Donante -->
<div class="modal fade" id="modalDonanteNuevo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form method="post" asp-action="CrearDonante" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title">Nuevo donante</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Nombre</label>
                        <input type="text" name="Nombre" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Apellidos</label>
                        <input type="text" name="Apellidos" class="form-control" />
                    </div>
                    <div class="col-md-8">
                        <label class="form-label">Email</label>
                        <input type="email" name="Email" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Teléfono</label>
                        <input type="text" name="Telefono" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Dirección</label>
                        <input type="text" name="Direccion" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Tipo de donante</label>
                        <select name="TipoDonante" class="form-select">
                            <option value="Persona">Persona</option>
                            <option value="Empresa">Empresa</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Estado</label>
                        <select name="Activo" class="form-select">
                            <option value="true">Activo</option>
                            <option value="false">Inactivo</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar donante</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: Editar Donante -->
<div class="modal fade" id="modalDonanteEditar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form method="post" asp-action="EditarDonante" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="IdDonante" id="editIdDonante" />
            <div class="modal-header">
                <h5 class="modal-title">Editar donante</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Nombre</label>
                        <input type="text" name="Nombre" id="editNombreDonante" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Apellidos</label>
                        <input type="text" name="Apellidos" id="editApellidosDonante" class="form-control" />
                    </div>
                    <div class="col-md-8">
                        <label class="form-label">Email</label>
                        <input type="email" name="Email" id="editEmailDonante" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Teléfono</label>
                        <input type="text" name="Telefono" id="editTelefonoDonante" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Dirección</label>
                        <input type="text" name="Direccion" id="editDireccionDonante" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Tipo de donante</label>
                        <select name="TipoDonante" id="editTipoDonante" class="form-select">
                            <option value="Persona">Persona</option>
                            <option value="Empresa">Empresa</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Estado</label>
                        <select name="Activo" id="editActivoDonante" class="form-select">
                            <option value="true">Activo</option>
                            <option value="false">Inactivo</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar cambios</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('modalDonanteEditar').addEventListener('show.bs.modal', function (event) {
            const btn = event.relatedTarget;
            document.getElementById('editIdDonante').value = btn.getAttribute('data-id');
            document.getElementById('editNombreDonante').value = btn.getAttribute('data-nombre') || '';
            document.getElementById('editApellidosDonante').value = btn.getAttribute('data-apellidos') || '';
            document.getElementById('editEmailDonante').value = btn.getAttribute('data-email') || '';
            document.getElementById('editTelefonoDonante').value = btn.getAttribute('data-telefono') || '';
            document.getElementById('editDireccionDonante').value = btn.getAttribute('data-direccion') || '';
            document.getElementById('editTipoDonante').value = btn.getAttribute('data-tipo') || 'Persona';
            document.getElementById('editActivoDonante').value = btn.getAttribute('data-activo') === 'true' ? 'true' : 'false';
        });
    </script>
}
