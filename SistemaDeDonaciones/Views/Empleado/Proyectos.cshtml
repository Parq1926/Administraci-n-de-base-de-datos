@model List<Proyecto>
@{
    var fundaciones = ViewData["Fundaciones"] as List<Fundacion> ?? new();
    var buscar = ViewData["Buscar"] as string;
    var idFundacionFiltro = ViewData["IdFundacionFiltro"] as int?;
    var estadoFiltro = ViewData["EstadoFiltro"] as string;
}

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Exito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="panel">
    <div class="panel-header">
        <h2>Listado de proyectos</h2>
        <button class="btn btn-primary btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#modalProyectoNuevo">
            <i class="bi bi-plus-lg"></i> Agregar proyecto
        </button>
    </div>

    <form method="get" asp-action="Proyectos" class="filter-bar row g-2">
        <div class="col-md-4">
            <input type="text" name="buscar" value="@buscar" class="form-control" placeholder="Buscar por nombre..." />
        </div>
        <div class="col-md-3">
            <select name="idFundacion" class="form-select">
                <option value="">Todas las fundaciones</option>
                @foreach (var f in fundaciones)
                {
                    <option value="@f.IdFundacion" selected="@(idFundacionFiltro == f.IdFundacion)">@f.Nombre</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <select name="estado" class="form-select">
                <option value="">Todos los estados</option>
                <option value="Activo" selected="@(estadoFiltro == "Activo")">Activo</option>
                <option value="Pausado" selected="@(estadoFiltro == "Pausado")">Pausado</option>
                <option value="Finalizado" selected="@(estadoFiltro == "Finalizado")">Finalizado</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-outline-secondary w-100"><i class="bi bi-filter"></i> Filtrar</button>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-ledger mb-0">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Fundación</th>
                    <th class="text-end">Recaudado</th>
                    <th class="text-end">Meta</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-soft py-4">No hay proyectos registrados con estos filtros.</td></tr>
                }
                @foreach (var p in Model)
                {
                    <tr>
                        <td>
                            @p.Nombre
                            <div class="progress mt-1" style="height:4px;max-width:140px;">
                                <div class="progress-bar" role="progressbar" style="width:@(p.PorcentajeAvance)%"></div>
                            </div>
                        </td>
                        <td class="text-soft">@p.FundacionNombre</td>
                        <td class="text-end mono">₡@p.Recaudado.ToString("N0")</td>
                        <td class="text-end mono">₡@((p.MetaRecaudacion ?? 0).ToString("N0"))</td>
                        <td>
                            @{
                                var badgeClass = p.Estado switch
                                {
                                    "Activo" => "badge-activo",
                                    "Finalizado" => "badge-inactivo",
                                    _ => "badge-pendiente"
                                };
                            }
                            <span class="badge-estado @badgeClass">@p.Estado</span>
                        </td>
                        <td>
                            <div class="row-actions">
                                <button class="icon-btn" type="button" title="Editar"
                                        data-bs-toggle="modal" data-bs-target="#modalProyectoEditar"
                                        data-id="@p.IdProyecto" data-nombre="@p.Nombre" data-descripcion="@p.Descripcion"
                                        data-meta="@p.MetaRecaudacion" data-idfundacion="@p.IdFundacion"
                                        data-estado="@p.Estado"
                                        data-inicio="@(p.FechaInicio?.ToString("yyyy-MM-dd"))"
                                        data-fin="@(p.FechaFin?.ToString("yyyy-MM-dd"))">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <form method="post" asp-action="EliminarProyecto" style="display:inline"
                                      onsubmit="return confirm('¿Eliminar el proyecto @p.Nombre?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="idProyecto" value="@p.IdProyecto" />
                                    <button class="icon-btn danger" type="submit" title="Eliminar"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!--Modal Agregar Proyecto-->
<div class="modal fade" id="modalProyectoNuevo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form method="post" asp-action="CrearProyecto" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title">Nuevo proyecto</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">Nombre</label>
                        <input type="text" name="Nombre" class="form-control" required />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Descripción</label>
                        <textarea name="Descripcion" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Fundación</label>
                        <select name="IdFundacion" class="form-select">
                            @foreach (var f in fundaciones)
                            {
                                <option value="@f.IdFundacion">@f.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Meta de recaudación (₡)</label>
                        <input type="number" name="MetaRecaudacion" class="form-control" placeholder="0.00" step="0.01" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Fecha de inicio</label>
                        <input type="date" name="FechaInicio" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Fecha de fin</label>
                        <input type="date" name="FechaFin" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Estado</label>
                        <select name="Estado" class="form-select">
                            <option value="Activo">Activo</option>
                            <option value="Pausado">Pausado</option>
                            <option value="Finalizado">Finalizado</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar proyecto</button>
            </div>
        </form>
    </div>
</div>

<!--Modal Editar Proyecto-->
<div class="modal fade" id="modalProyectoEditar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form method="post" asp-action="EditarProyecto" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="IdProyecto" id="editIdProyecto" />
            <div class="modal-header">
                <h5 class="modal-title">Editar proyecto</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">Nombre</label>
                        <input type="text" name="Nombre" id="editNombreProyecto" class="form-control" required />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Descripción</label>
                        <textarea name="Descripcion" id="editDescripcionProyecto" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Fundación</label>
                        <select name="IdFundacion" id="editIdFundacionProyecto" class="form-select">
                            @foreach (var f in fundaciones)
                            {
                                <option value="@f.IdFundacion">@f.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Meta de recaudación (₡)</label>
                        <input type="number" name="MetaRecaudacion" id="editMetaProyecto" class="form-control" step="0.01" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Fecha de inicio</label>
                        <input type="date" name="FechaInicio" id="editInicioProyecto" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Fecha de fin</label>
                        <input type="date" name="FechaFin" id="editFinProyecto" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Estado</label>
                        <select name="Estado" id="editEstadoProyecto" class="form-select">
                            <option value="Activo">Activo</option>
                            <option value="Pausado">Pausado</option>
                            <option value="Finalizado">Finalizado</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar cambios</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('modalProyectoEditar').addEventListener('show.bs.modal', function (event) {
            const btn = event.relatedTarget;
            document.getElementById('editIdProyecto').value = btn.getAttribute('data-id');
            document.getElementById('editNombreProyecto').value = btn.getAttribute('data-nombre') || '';
            document.getElementById('editDescripcionProyecto').value = btn.getAttribute('data-descripcion') || '';
            document.getElementById('editIdFundacionProyecto').value = btn.getAttribute('data-idfundacion') || '';
            document.getElementById('editMetaProyecto').value = btn.getAttribute('data-meta') || '';
            document.getElementById('editInicioProyecto').value = btn.getAttribute('data-inicio') || '';
            document.getElementById('editFinProyecto').value = btn.getAttribute('data-fin') || '';
            document.getElementById('editEstadoProyecto').value = btn.getAttribute('data-estado') || 'Activo';
        });
    </script>
}
